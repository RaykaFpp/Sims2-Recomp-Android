# build
/out/
/build/
*.zip
*.pdb
*.exe
*.obj
*.o

# recompiled code, derived from the game
/generated/

# user's own game files: the disc image and everything extracted from it, plus the
# 4k movie assets regenerated from them by tools/upscale_movies.py
/assets/
/assets/movies_4k/
*.iso

# downloaded media tools; tools/upscale_movies.py itself stays tracked
/tools/bin/

# locally installed build toolchain
/.toolchain/

# runtime files
settings.toml
/logs/
/hdd/
/CrashDumps/

# Release artifacts: built by release.sh / release.bat, attached to a GitHub
# release, never committed.
/Sims2-linux-x64.tar.zst
/Sims2-win64.zip
/Sims2.zip

# editors
.vs/
.vscode/
.idea/

# Local temporary folder
.local
__pycache__/

# Android local build output and IDE state
/android/.gradle/
/android/.androidide/
/android/build/
/android/app/build/
/android/app/.cxx/
